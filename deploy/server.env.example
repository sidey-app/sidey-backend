# Copy outside the repository, mode 0600. No shell evaluation; nerdctl --env-file.
SIDEY_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/sidey
SIDEY_DATABASE_USER=sidey
SIDEY_DATABASE_PASSWORD=
SIDEY_JWT_SECRET=
SIDEY_JWT_ISSUER=sidey
SIDEY_INVITE_PEPPER=
SIDEY_GOOGLE_AUDIENCES=
SIDEY_APPLE_AUDIENCES=
SIDEY_DEPLOYMENT_KEY=
SIDEY_COMMERCE_OPS_KEY=
SIDEY_WEBSITE_URL=https://sidey-app.github.io/SIDEY/
SIDEY_WEBSITE_ORIGIN=https://sidey-app.github.io
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
APPLE_BUNDLE_ID=
APPLE_APP_ID=0
APPLE_ROOT_CERTIFICATES=/run/secrets/apple-root.der
APPLE_IAP_PRIVATE_KEY_FILE=/run/secrets/apple-iap.p8
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_PRIVATE_KEY_FILE=/run/secrets/apple-signin.p8
# Legacy ownership proof only; remove after the agreed claim window.
SIDEY_LEGACY_SUPABASE_ORIGIN=
SIDEY_LEGACY_SUPABASE_API_KEY=
